        "3 of 4 sessions are done."
      ]
    },
    {
      "id": "diet-instructions",
      "rule": "U1/U6",
      "pattern": "\\b(skip|miss|drop|cut\\s+out)\\s+(your\\s+|the\\s+)?(dinner|lunch|breakfast|meals?|snacks?)\\b|\\bstop\\s+eating\\b|\\b(don't|do\\s+not|never)\\s+eat\\b|\\beat\\s+only\\b|\\bonly\\s+eat\\b|\\b(intermittent\\s+)?fast(ing)?\\s+(for|until|today|tomorrow|tonight|\\d)|\\bno\\s+(carbs|sugar|food)\\b|\\b(akşam|öğle|sabah)\\s+yemeğini\\s+atla\\w*|\\bkahvaltıyı\\s+atla\\w*|\\böğün\\s+atla\\w*|\\baç\\s+kal\\w*|\\boruç\\b|\\byalnızca\\s+\\w+\\s+ye\\b|\\bsadece\\s+\\w+\\s+ye\\b|\\bhiçbir\\s+şey\\s+yeme\\w*",
      "examples": [
