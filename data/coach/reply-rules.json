{
  "_about": "What a reply of the conversational coach may never say (ADR-092 #2, U1 U2 U6 U7 U10), beside data/copy/forbidden-phrases.json (U4, U6, names): a reply that carries any of these is not shown — the engine's own sentence is (ReplyValidator). English and Turkish. Each rule has the examples it must catch and the near-misses it must let through; ReplyRulesTests checks them. The rules fail closed: a good reply the rules also catch is lost, a bad one is not shown.",
  "rules": [
    {
      "id": "changes-the-call-en",
      "rule": "U1/U2",
      "pattern": "\\b(i('|\\s)?ll|i\\s+will|i\\s+have|i've|we('|\\s)?ll|let's|we\\s+can|we\\s+could|i\\s+can|i\\s+could)\\s+(change|adjust|lower|raise|reduce|increase|cut|drop|soften|postpone|delay|skip|move|switch|swap|ease|lighten|make\\s+(it|that|the\\s+(call|cut|step)))\\b|\\b(you('|\\s)?re|you\\s+are)\\s+(absolutely\\s+|totally\\s+|completely\\s+)?(right|correct)\\b|\\b(good|fair)\\s+(point|enough)\\b|\\b(cut|reduce|lower|drop|slash|increase|raise|skip|stop)\\s+(your\\s+|the\\s+|some\\s+)?(daily\\s+|weekly\\s+)?(calories|kcal|carbs|protein|fat|food|meals?|sets|reps|training|workouts?|steps|cardio)\\b|\\b(eat|consume|train|lift|walk)\\s+(a\\s+bit\\s+|a\\s+little\\s+)?(less|more|fewer)\\b|\\binstead\\s+of\\s+the\\s+(call|plan|cut|step)\\b|\\b(new|updated|revised|changed)\\s+(call|target|step|plan)\\b|\\b(maintenance|deload)\\s+(this|next)\\s+week\\b|\\bi\\s+agree\\b|\\byou\\s+(have|ve\\s+got|'ve\\s+got)\\s+a\\s+point\\b|\\byou\\s+make\\s+a\\s+(good\\s+)?point\\b|\\bthat\\s+makes\\s+sense,?\\s+(so\\s+)?(let|we|i)\\b",
      "examples": [
        "You're right, I'll lower the cut this week.",
        "Let's make it smaller for now.",
        "We can postpone the step until after the trip.",
        "Good point, that is a lot.",
        "Try to cut your calories a little more.",
        "You could eat more on training days.",
        "Here is the new call for this week.",
        "Take maintenance this week.",
        "I agree, a smaller step is fine.",
        "You have a point, we'll ease off."
      ],
      "nonExamples": [
        "The call stands this week: the weight is not moving toward your goal.",
        "The cut is 500 kcal a day because three weeks of data show a stall.",
        "I hear you. The call stays because the trend is flat.",
        "Three of four sessions are done, which counts toward the week."
      ]
    },
    {
      "id": "changes-the-call-tr",
      "rule": "U1/U2",
      "pattern": "haklısın|haklısınız|haklı\\s+olabilirsin|\\b(kalori|kcal|karbonhidrat|protein)\\w*\\s+(düşür|azalt|kıs|artır|arttır|kes)\\w*|\\b(düşür|azalt|kıs|artır|arttır|kes|atla)\\w*\\s+(kalori|kcal)|\\w*(değiştir|ertele|yumuşat|düşür|azalt)(elim|ebiliriz|ebilirim|eceğim|irim|iyorum)\\b|\\byeni\\s+(karar|hedef|adım|plan)\\b|\\b(daha\\s+az|daha\\s+fazla)\\s+(ye|ye\\w*|antren\\w*)\\b|doğru\\s+söylüyorsun|haklı\\s+bir\\s+noktaya|katılıyorum|\\b(azalt|ertele|yumuşat|atla|düşür|değiştir|artır|arttır|kıs|kes|bırak|hafiflet)\\w{0,4}(alım|elim|ayalım|eyelim|abilirim|ebilirim|abiliriz|ebiliriz|acağım|eceğim|ırım|irim)\\b",
      "examples": [
        "Haklısın, bu hafta kaloriyi düşürelim.",
        "Kaloriyi azalt, daha rahat olur.",
        "Adımı değiştirebiliriz.",
        "Bu haftaki yeni karar şu.",
        "Doğru söylüyorsun, azaltalım.",
        "Bu haftayı erteleyelim.",
        "Adımı yumuşatalım.",
        "O öğünü atlayalım."
      ],
      "nonExamples": [
        "Karar bu hafta aynı kalıyor: kilo hedefe doğru gitmiyor.",
        "Üç haftalık veri düz bir seyir gösteriyor."
      ]
    },
    {
      "id": "medical-tr",
      "rule": "U6",
      "pattern": "\\b(teşhis|tanı\\s+koy\\w*|tedavi\\w*|ilaç\\w*|reçete\\w*|hastalık\\w*|diyabet\\w*|insülin\\w*|tiroid\\w*|obezite\\w*|yeme\\s+bozukluğ\\w*|belirti\\w*|hormon\\w*|sağlık\\s+sorun\\w*|kan\\s+şeker\\w*|kolesterol\\w*|kanser\\w*|\\bağrı\\w*|hamile\\w*|metformin|\\bacil\\b|sakatlık\\w*)",
