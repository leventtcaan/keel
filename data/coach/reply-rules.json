    },
    {
      "id": "links-and-markup",
      "rule": "form",
      "pattern": "https?://|\\bwww\\.|\\]\\([^)]*\\)|<\\s*/?\\s*[a-z][^>]*>|'''|^\\s*[-*•]\\s",
      "examples": [
