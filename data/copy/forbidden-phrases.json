{
  "_about": "Phrases no user-facing text may contain (K-302). Checked against every string in en.json by apps/mobile/src/__tests__/forbidden-phrases.test.ts. Patterns are case-insensitive JavaScript regular expressions. Every rule carries examples it must catch and near-misses it must let through; coachingNonExamples are ordinary coaching sentences no rule may catch. A number in copy is usually a {placeholder}, so number branches accept both. personNames (K-523): no person's name in the copy, the contract or the product's code, a research path aside.",
  "rules": [
    {
      "id": "body-fat-number",
      "rule": "U4",
      "source": "docs/anayasa.md#U4",
      "why": "A body-fat percentage is never shown, nor lean or fat mass as a share (lean % is 100 − fat %); fat is an internal engine variable. Bare 'fat' is not matched: macro splits (30% fat) are food copy.",
      "pattern": "\\b(body[\\s-]*fat|bf|fat[\\s-]*mass|lean([\\s-]*(body[\\s-]*)?mass)?)\\b[^.%\\n]{0,20}?(\\d+|\\{\\w+\\})\\s*(%|percent(age)?|per\\s*cent)|(\\d+|\\{\\w+\\})\\s*(%|percent|per\\s*cent)\\s*(body[\\s-]*fat|bf\\b|fat[\\s-]*mass|lean)|\\b(body[\\s-]*fat|bf|fat[\\s-]*mass|lean[\\s-]*mass)\\s*(%|percent(age)?)|\\bpercent(age)?\\s+(of\\s+)?(body[\\s-]*fat|fat[\\s-]*mass|lean)",
      "examples": [
        "Body fat %",
        "your body-fat percentage",
        "about 18% body fat",
        "BF%",
        "percentage of body fat",
        "Body fat: 18%",
        "body fat sits at 18%",
        "BF 18%",
        "18%BF",
        "18 per cent body fat",
        "Body fat {value}%",
