    {
      "id": "risk-and-lab-claims",
      "rule": "U6",
      "source": "docs/anayasa.md#U6",
      "why": "No risk-reduction claims and no reading of lab markers; blood tests are not interpreted (Turkish).",
      "pattern": "(?<![\\p{L}\\d])(?:risk(?:ini|i)?\\s+(?:azalt|düşür)\\p{L}*|karşı\\s+korur|kan\\s+(?:şekeri|basıncı|tahlil\\p{L}*|test\\p{L}*|değer\\p{L}*)|tansiyon\\p{L}*|glikoz(?![\\p{L}])|hba1c|kolesterol\\p{L}*)",
      "examples": [
