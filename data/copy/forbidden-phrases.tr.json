        "İnsülin direncin var",
        "prediyabet",
        "diyabetliler",
        "metabolik sendrom",
        "PKOS",
        "hipotiroidi",
        "tiroid sorunu",
        "kalp hastalığı",
        "yeme bozukluğu",
        "bir semptom",
