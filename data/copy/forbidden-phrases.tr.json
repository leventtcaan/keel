{
  "_about": "Turkish counterpart of forbidden-phrases.json (K-1212): phrases no Turkish user-facing text may contain, checked against every string in tr.json and store.tr.json by apps/mobile/src/__tests__/copy-tr.test.ts. Patterns are Unicode regular expressions (flags \"iu\"): JavaScript word boundaries are ASCII-only and would split Turkish letters, so words are bounded with lookarounds on \\p{L}, and a word that can start with a dotted or dotless I spells both ([iİ]). Turkish words take suffixes, so stems end in \\p{L}*. Every rule carries examples it must catch and near-misses it must let through; coachingNonExamples are ordinary coaching sentences no rule may catch. Person names and the quota-currency words (kredi, jeton) are the English file's lists, read for Turkish text too (the English quotaWords pattern already has kredi and jeton).",
  "rules": [
    {
      "id": "body-fat-number",
      "rule": "U4",
      "source": "docs/anayasa.md#U4",
      "why": "Turkish counterpart of the English rule: a body-fat percentage is never shown, nor lean or fat mass as a share. Bare \"yağ\" is not matched: macro splits (yağ %30) are food copy.",
      "pattern": "(?<![\\p{L}\\d])(?:vücut\\s*yağ\\p{L}*|yağ\\s*oran\\p{L}*|yağ\\s*yüzde\\p{L}*|yağ\\s*kütle\\p{L}*|yağsız(?:\\s*(?:vücut\\s*)?(?:kütle|kitle)\\p{L}*)?|bf)[^.%\\n]{0,20}?(?:%\\s*(?:\\d+|\\{\\w+\\})|(?:\\d+|\\{\\w+\\})\\s*%|yüzde\\s*(?:\\d+|\\{\\w+\\}))|(?:%\\s*(?:\\d+|\\{\\w+\\})|(?:\\d+|\\{\\w+\\})\\s*%|yüzde\\s*(?:\\d+|\\{\\w+\\}))\\s*(?:vücut\\s*yağ\\p{L}*|yağ\\s*oran\\p{L}*|yağ\\s*yüzde\\p{L}*|yağ\\s*kütle\\p{L}*|yağsız(?:\\s*(?:vücut\\s*)?(?:kütle|kitle)\\p{L}*)?|bf)|(?<![\\p{L}\\d])(?:vücut\\s*yağ\\p{L}*|yağ\\s*oran\\p{L}*|yağ\\s*kütle\\p{L}*|bf)\\s*(?:%|yüzde)|(?<![\\p{L}\\d])yüzde\\s+(?:vücut\\s*yağ|yağ\\s*oran|yağ\\s*kütle|yağsız)|(?<![\\p{L}\\d])yağ\\s*yüzde\\p{L}*",
      "examples": [
        "Vücut yağı %",
        "vücut yağ yüzdesi",
        "yaklaşık %18 vücut yağı",
        "BF%",
        "Vücut yağı: %18",
        "vücut yağın 18% civarında",
        "vücut yağı {value}%",
        "yağ oranı %{value}",
        "18 yüzde yağ oranı",
        "{low}-{high}% vücut yağı",
        "yağsız kütle %82",
        "Yağ yüzdesi",
        "yüzde 18 vücut yağı",
        "Yağ kütlesi %12"
      ],
      "nonExamples": [
        "Yağ kaybedersin, kas değil",
        "Planın %80'i yapıldı",
        "yağ 60 g",
        "daha az yağlı bir öğün",
        "Protein %30, karbonhidrat %40, yağ %30",
        "%2 yağlı süt",
        "Yağsız: {weight} kg",
        "Yeterince yağsızsın",
        "Yağ hedefi 60 g"
      ]
    },
    {
      "id": "condition-names",
      "rule": "U6",
      "source": "docs/anayasa.md#U6",
      "why": "No diagnosis or condition names, insulin resistance included (Turkish).",
      "pattern": "(?<![\\p{L}\\d])(?:[iİ]nsülin\\s+diren[çc]\\p{L}*|(?:pre)?diyabet\\p{L}*|şeker\\s+hastalığ\\p{L}*|metabolik\\s+(?:sendrom|hasar)\\p{L}*|pkos|polikistik\\s+over\\p{L}*|hipotiroid\\p{L}*|hipertiroid\\p{L}*|tiroid\\p{L}*|hastalık\\p{L}*|hastalığ\\p{L}*|bozukluk\\p{L}*|bozukluğ\\p{L}*|semptom\\p{L}*|sendrom\\p{L}*|obezite\\p{L}*|hipertansiyon\\p{L}*|amenore\\p{L}*|red-s|göreceli\\s+enerji\\s+eksikliğ\\p{L}*|anoreksiya\\p{L}*|bulimiya\\p{L}*|yağlı\\s+karaciğer\\p{L}*|leptin\\s+diren[çc]\\p{L}*|(?:tıbbi|sağlık)\\s+(?:durum|sorun)\\p{L}*)",
      "examples": [
