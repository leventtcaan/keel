      "pattern": "(?<![\\p{L}\\d])(?:tedavi\\p{L}*|teşhis\\p{L}*|tanı\\s+koy\\p{L}*|tanıs\\p{L}*|tanı(?![\\p{L}])|[iİ]yileş\\p{L}*|şifa\\p{L}*|çare\\p{L}*|önler(?![\\p{L}])|önley\\p{L}*|önleme\\p{L}*|klinik\\p{L}*|reçete\\p{L}*|hastalar(?![\\p{L}])|(?:zayıflama|kilo\\s+verme)\\s+(?:ila[çc]|hap|çay|kür)\\p{L}*|yağ\\s+yakıcı\\p{L}*|detoks\\p{L}*|terapi\\p{L}*|mucize\\p{L}*)",
      "examples": [
