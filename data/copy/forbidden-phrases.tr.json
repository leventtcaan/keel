      ]
    },
    {
      "id": "blame-and-compensation",
      "rule": "U7",
      "source": "docs/anayasa.md#U7",
      "why": "No blame, shaming or compensation mechanics, and no streak that resets (Turkish). The list holds words, not negations: a text that must say \"no guilt\" says it another way (\"sorun değil\").",
      "pattern": "(?<![\\p{L}\\d])(?:telafi\\p{L}*|ceza\\p{L}*|tembel\\p{L}*|başarısız\\p{L}*|hile(?![\\p{L}])|hile\\s+gün\\p{L}*|bahane\\p{L}*|suçlu\\p{L}*|günah\\p{L}*|hak\\s+et\\p{L}*|seri(?:n|si|yi)?\\s+(?:bozul|kaybet|sıfırlan|bitti)\\p{L}*|günlük\\s+seri\\p{L}*|streak)",
      "examples": [
