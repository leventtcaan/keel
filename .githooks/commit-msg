#!/bin/sh
# keel: no AI attribution in commit messages (CLAUDE.md "Git", ADR-019). Enabled with:
#   git config core.hooksPath .githooks
if grep -qiE 'Co-Authored-By:[[:space:]]*Claude|noreply@anthropic\.com|Generated with \[?Claude' "$1"; then
  echo "commit-msg: AI attribution is not allowed in keel commits (CLAUDE.md Git)." >&2
  exit 1
fi
