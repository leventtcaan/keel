{
  "cli": { "version": ">= 20.3.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TERMS_URL": "https://leventtcaan.github.io/keel/terms/",
        "EXPO_PUBLIC_PRIVACY_URL": "https://leventtcaan.github.io/keel/privacy/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
