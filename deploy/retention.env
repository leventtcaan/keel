# How long the server's backups and logs are kept (K-901, ADR-065) — the one place these numbers are written. The privacy
# policy and the data inventory state them; tools/test_deploy.py and tools/test_veri_envanteri.py keep them equal.
# Encrypted database backups on the server, then on the controller's own computer (pulled, deploy/mac/pull-backups.sh).
BACKUP_KEEP_DAYS_SERVER=7
BACKUP_KEEP_DAYS_MAC=14
# The Mac tells (a notification) when its newest backup is older than this: a day's backup plus room.
BACKUP_ALERT_HOURS=26
# Every container's log (journald): the backend's, PostgreSQL's and Caddy's. Caddy keeps no access log (Caddyfile).
LOG_KEEP_DAYS=14
