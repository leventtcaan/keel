# /opt/keel/.env on the VPS — names only (V5); deploy/init-env.sh writes the file (owner keel, mode 600) without the values
# ever being printed. tools/test_deploy.py checks this list against what the server and compose.yaml read.
KEEL_DOMAIN=
KEEL_DB_PASSWORD=
KEEL_SESSION_SECRET=
KEEL_APPLE_CLIENT_ID=
KEEL_APPLE_TEAM_ID=
KEEL_APPLE_KEY_ID=
KEEL_APPLE_PRIVATE_KEY=
KEEL_REVENUECAT_WEBHOOK_SECRET=
