# The reverse proxy (K-901, ADR-065). Caddy gets and renews the HTTPS certificate itself (Let's Encrypt) and sends plain
# HTTP to HTTPS. No `log` directive: Caddy keeps no access log (the privacy policy says so; tools/test_deploy.py checks).
{$KEEL_DOMAIN} {
	# A meal photo is at most 2.5 MB, sent as base64 JSON (keel.coach.photo.max-bytes): 5 MB covers it with room.
	request_body {
		max_size 5MB
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# The backend counts requests by client address (K-817). reverse_proxy sets X-Forwarded-For to the address Caddy saw and
	# ignores one a client sends, as long as no trusted_proxies is named here (tools/test_deploy.py keeps it so).
	reverse_proxy backend:8080
}

# Other sites on this server (K-1010): one *.caddy file each in /opt/sites, outside keel's deploy. An empty folder is fine.
import /etc/caddy/sites/*.caddy
