     "train.gym",
     "train.history",
     "train.own",
     "train.program",
     "train.setup",
     "units"
    ],
    "survives_sign_out": [
     "projection.access"
    ]
   },
   {
    "what": "Local notifications (reminders, rest timer, trial reminder) — no push token",
