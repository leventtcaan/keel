 "outbound": [
  {
   "recipient": "Apple",
   "data": "Sign in with Apple: Apple gives us a stable user id for this app; no name, no email is asked. Our server fetches Apple's public keys. When you delete your account, our server sends Apple a one-time code from a fresh Sign in with Apple, signed with our developer key, and asks Apple to end this app's sign-in for you (K-812, ADR-062); nothing Apple answers is kept.",
   "when": "sign-in; account deletion",
   "basis": "contract",
   "active": true,
   "policy": "recipients",
   "app_privacy": []
  },
  {
   "recipient": "RevenueCat",
   "data": "Your account's random id; the RevenueCat SDK also receives the App Store purchase record, store country and currency, device and iOS version, and IP address. [SDK data list from ADR-012 Ek 1; RevenueCat's privacy guide (4 Oct 2026) says it collects purchase history]",
   "when": "when the plans are shown (every new account after onboarding — K-706 gate), on restore and on manage subscription",
   "basis": "contract",
   "active": true,
   "policy": "recipients",
   "app_privacy": [
    "Purchases › Purchase History",
    "Identifiers › User ID"
   ]
  },
  {
   "recipient": "Contabo",
   "data": "Everything stored on our server, as our hosting provider (processor).",
   "when": "always",
   "basis": "contract",
   "active": true,
   "policy": "recipients",
   "app_privacy": []
  },
  {
   "recipient": "AI provider",
   "data": "What you write to the coach with the kind of this week's call and its rules (no numbers); meal notes you type; meal photos you choose to analyze.",
   "when": "only with the separate AI consent naming the provider",
   "basis": "explicit consent",
   "active": false,
   "policy": "ai",
   "app_privacy": [],
   "app_privacy_when_active": [
    "User Content › Other User Content",
    "User Content › Photos or Videos",
    "Health & Fitness › Health"
   ],
   "note": "Not active: provider chosen at launch (K-533); consent cannot be given today (no third-party-ai config).",
   "terms": "docs/yasal/ai-saglayici-sartlari.md (K-806): candidates' training and retention terms, read 2026-10-04; condition ADR-041 #71 (no training, zero data retention)"
  }
 ],
