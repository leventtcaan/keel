  {
   "table": "identity.refresh_token",
   "module": "identity",
   "class": "account",
   "purpose": "Signed-in sessions, stored only as SHA-256 hashes of the refresh tokens; a session ends after 60 days without use (refresh-ttl), at sign-out or with the account.",
   "columns": [
    "id",
    "account_id",
    "family_id",
    "token_hash",
    "expires_at",
    "revoked_at",
    "created_at"
   ],
   "basis": "contract (Art. 6(1)(b))",
   "gated_by": null,
   "erased_by": [
    "account_deletion",
    "time"
   ],
   "kept_for": "until every token of its session has expired — each lasts 60 days from its renewal, and a replaced or signed-out one is kept until then to catch a stolen copy — then the nightly cleanup (RefreshTokenCleanup, 03:45 UTC)",
   "exported": false,
   "policy": "data-account",
   "app_privacy": [],
   "note": "A family goes the night after its last token expires (K-810); until then every row stays, revoked or expired, for reuse detection (RefreshTokens.rotate)."
  },
