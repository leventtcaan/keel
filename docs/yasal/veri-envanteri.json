 "phone": {
  "permissions": [
   {
    "copy_key": "healthRead",
    "what": "Read from Apple Health: steps, sleep, body weight, active energy (workouts type requested, not read)",
    "policy": "data-apple-health"
   },
   {
    "copy_key": "healthWrite",
    "what": "Write to Apple Health: your logged workouts and weigh-ins, only if you turn it on",
    "policy": "data-apple-health"
   },
   {
    "copy_key": "camera",
    "what": "Camera: barcodes, meal photos, progress photos",
    "policy": "data-photos"
   },
   {
    "copy_key": "photos",
    "what": "Photo library: pick a meal or progress photo",
    "policy": "data-photos"
   }
  ],
  "stored": [
   {
    "what": "Progress photos (Documents/progress-photos), never uploaded and left out of the phone's iCloud and computer backups (K-618); and whose account they belong to (SHA-256 of the Apple user id)",
    "policy": "data-photos",
    "kv_keys": [
     "photos.owner"
    ]
   },
   {
    "what": "Session tokens in the Keychain (this device only)",
    "policy": "data-on-phone"
   },
   {
    "what": "A local copy of what you log (SQLite), sent to the server when online",
    "policy": "data-on-phone"
   },
   {
    "what": "Settings and states on the phone: appearance (light, dark or system), units, consents, reminders (all, or the check-in morning alone) and your reminder sentence, declared state, eating-pattern check result (answers never stored), projection, subscription gate, trial reminder, training cache (program, exercises, gym, history, own moves, setups), Apple Health write switches and the steps, sleep and active energy of the recent days sent (up to 28, so none is sent twice), onboarding done or still open (plan not yet seen), whether the account met the subscription screen, the profile's sex (for the muscle map's figure), the last days the app was opened (never sent: a long gap, reminders' timing)",
